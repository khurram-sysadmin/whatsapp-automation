DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(signup|login|forgot-password|reset-password|dashboard|campaigns|contacts|templates|messages|replies|suppression|settings|inbox|whatsapp-accounts|analytics|team|billing)/$ $1 [R=302,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^(signup|login|forgot-password|reset-password|dashboard|campaigns|contacts|templates|messages|replies|suppression|settings|inbox|whatsapp-accounts|analytics|team|billing)/?$ index.html [L]
  RewriteRule ^[^/]+$ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
</IfModule>

<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
